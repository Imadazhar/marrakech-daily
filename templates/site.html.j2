<!-- ═══════════════════════════════════════════
     JAVASCRIPT
═══════════════════════════════════════════ -->
<script>
// ── Article data injected by agent ──────────────────────
const ARTICLES = {{ articles_json }};

// ── Modal ────────────────────────────────────────────────
function openArticle(slug) {
  const a = ARTICLES[slug];
  if (!a) return;
  document.getElementById('modalImg').src    = a.image_url || '';
  document.getElementById('modalImg').alt    = a.title || '';
  document.getElementById('modalTitle').textContent = a.title || '';
  document.getElementById('modalCat').innerHTML =
    `<span class="cat-badge ${a.is_breaking ? 'breaking' : ''}">${a.is_breaking ? '⚡ BREAKING · ' : ''}${a.category || ''}</span>`;
  document.getElementById('modalMeta').innerHTML =
    `<span class="author">${a.author_name || 'Editorial Staff'}</span>
     <span>|</span>
     <span>${a.author_role || ''}</span>
     <span>|</span>
     <span>${a.date_display || ''}</span>
     <span>|</span>
     <span>${a.reading_time || 3} min read</span>`;
  document.getElementById('modalContent').innerHTML = a.body_html || '';
  const srcEl = document.getElementById('modalSrc');
  if (a.source_url && a.source_name) {
    srcEl.innerHTML = `Source: <a href="${a.source_url}" target="_blank" rel="noopener noreferrer">${a.source_name}</a>. This article was written independently in English based on verified facts.`;
    srcEl.style.display = 'block';
  } else {
    srcEl.style.display = 'none';
  }
  document.getElementById('modalTags').innerHTML =
    (a.tags || []).map(t => `<span class="tag">${t}</span>`).join('');
  document.getElementById('articleModal').classList.add('open');
  document.body.style.overflow = 'hidden';
  document.getElementById('articleModal').scrollTop = 0;

  // Update URL hash for sharing
  history.pushState(null, '', `#${slug}`);

  // Schema markup for article
  const schema = {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: a.title,
    description: a.excerpt,
    datePublished: a.published_at,
    author: { '@type': 'Person', name: a.author_name || 'Editorial Staff' },
    publisher: {
      '@type': 'NewsMediaOrganization',
      name: 'Marrakech Daily',
      url: '{{ site_url }}/'
    },
    image: a.image_url,
    url: `{{ site_url }}/#${slug}`
  };
  let sd = document.getElementById('articleSchema');
  if (!sd) { sd = document.createElement('script'); sd.id = 'articleSchema'; sd.type = 'application/ld+json'; document.head.appendChild(sd); }
  sd.textContent = JSON.stringify(schema);
}

function closeModal() {
  document.getElementById('articleModal').classList.remove('open');
  document.body.style.overflow = '';
  history.pushState(null, '', window.location.pathname);
}

document.getElementById('modalClose').addEventListener('click', closeModal);
document.getElementById('articleModal').addEventListener('click', e => { if (e.target === document.getElementById('articleModal')) closeModal(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// Open article from URL hash on load
window.addEventListener('load', () => {
  const hash = location.hash.slice(1);
  if (hash && ARTICLES[hash]) openArticle(hash);
});

// ── Navigation / Category Filter ────────────────────────
document.querySelectorAll('.nav-link').forEach(link => {
  link.addEventListener('click', () => {
    document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
    link.classList.add('active');
    const cat = link.dataset.cat;
    filterByCategory(cat);
  });
  link.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); link.click(); }
  });
});

function filterByCategory(cat) {
  if (cat === 'all') return;
  const match = Object.entries(ARTICLES).find(([, a]) =>
    (a.category || '').toLowerCase() === cat.toLowerCase()
  );
  if (match) openArticle(match[0]);
}

// ── Search ────────────────────────────────────────────────
const searchToggle = document.getElementById('searchToggle');
const searchBar    = document.getElementById('searchBar');
const searchInput  = document.getElementById('searchInput');
const searchResults= document.getElementById('searchResults');

function openSearch() {
  searchBar.classList.add('open');
  searchToggle.setAttribute('aria-expanded', 'true');
  searchInput.focus();
}
function closeSearch() {
  searchBar.classList.remove('open');
  searchToggle.setAttribute('aria-expanded', 'false');
  searchResults.innerHTML = '';
  searchInput.value = '';
}
searchToggle.addEventListener('click', () => {
  searchBar.classList.contains('open') ? closeSearch() : openSearch();
});

searchInput.addEventListener('input', () => {
  const q = searchInput.value.trim().toLowerCase();
  if (q.length < 2) { searchResults.innerHTML = ''; return; }
  const hits = Object.entries(ARTICLES).filter(([, a]) =>
    (a.title || '').toLowerCase().includes(q) ||
    (a.excerpt || '').toLowerCase().includes(q) ||
    (a.category || '').toLowerCase().includes(q) ||
    (a.tags || []).some(t => t.toLowerCase().includes(q))
  ).slice(0, 7);
  if (!hits.length) {
    searchResults.innerHTML = '<p style="color:var(--muted);padding:8px 0">No results found.</p>';
    return;
  }
  searchResults.innerHTML = hits.map(([slug, a]) =>
    `<div class="search-result-item" onclick="openArticle('${slug}');closeSearch()" role="option" tabindex="0">
      <div class="sri-cat">${a.category || ''}</div>
      <div class="sri-title">${a.title || ''}</div>
    </div>`
  ).join('');
  searchResults.querySelectorAll('[role="option"]').forEach(el => {
    el.addEventListener('keydown', e => { if (e.key === 'Enter') el.click(); });
  });
});

// ── Scroll Effects ────────────────────────────────────────
const header = document.getElementById('siteHeader');
let lastScroll = 0;
window.addEventListener('scroll', () => {
  const y = window.scrollY;
  header.classList.toggle('scrolled', y > 40);
  lastScroll = y;
}, { passive: true });

// ── Newsletter ────────────────────────────────────────────
document.getElementById('nlBtn').addEventListener('click', function() {
  const inp = document.getElementById('nlEmail');
  const v = inp.value.trim();
  if (!v || !v.includes('@')) {
    inp.style.outline = '2px solid var(--red)';
    inp.focus();
    return;
  }
  inp.style.outline = '';
  this.textContent  = '✓ You\'re in!';
  this.style.background = '#0A5C45';
  inp.value = '';
  setTimeout(() => {
    this.textContent  = 'Subscribe Free';
    this.style.background = '';
  }, 3000);
});
</script>
</body>
</html>
