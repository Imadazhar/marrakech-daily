<!-- ── Article Modal ────────────────────────────────────────────── -->
<div class="modal-backdrop" id="modal-backdrop" onclick="closeModal(event)">
  <div class="modal" id="modal-box" role="dialog" aria-modal="true">
    <button class="modal-close" onclick="closeModalBtn()" aria-label="Close">✕</button>
    <img src="" alt="" class="modal-hero-img" id="modal-img">
    <div class="modal-body">
      <div class="modal-cat" id="modal-cat"></div>
      <h2 class="modal-title" id="modal-title"></h2>
      <p class="modal-desc" id="modal-desc"></p>
      <div class="modal-byline" id="modal-byline"></div>
      <div class="modal-content" id="modal-content"></div>
      <div class="modal-tags" id="modal-tags"></div>
    </div>
  </div>
</div>

<!-- ── Article data (embedded JSON) ─────────────────────────────── -->
<script>
const ARTICLES = {{ articles | tojson }};
const articleMap = {};
ARTICLES.forEach(a => { articleMap[a.slug] = a; });

/** Escape a string for safe use inside HTML attribute values. */
function escAttr(s) {
  return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

/** Safely build the byline DOM tree without innerHTML on untrusted strings. */
function buildByline(a) {
  const el = document.getElementById('modal-byline');
  el.innerHTML = '';
  const prefix = document.createTextNode('By ');
  const strong = document.createElement('strong');
  strong.textContent = a.author && a.author.name ? a.author.name : 'Staff';
  const rest = document.createTextNode(
    ' | ' + (a.author && a.author.role ? a.author.role : '') +
    ' | ' + (a.date_display || '') +
    ' | ' + (a.reading_time || 1) + ' min read'
  );
  el.appendChild(prefix);
  el.appendChild(strong);
  el.appendChild(rest);
}

/** Build tags safely without innerHTML on untrusted tag strings. */
function buildTags(tags) {
  const el = document.getElementById('modal-tags');
  el.innerHTML = '';
  (tags || []).forEach(t => {
    const span = document.createElement('span');
    span.className = 'modal-tag';
    span.textContent = t;
    el.appendChild(span);
  });
}

function openArticle(slug) {
  const a = articleMap[slug];
  if (!a) return;

  // Safe: these are controlled URLs from Python-generated data
  const img = document.getElementById('modal-img');
  img.src = a.hero_image || '';
  img.alt = '';  // set via textContent below isn't possible for alt, but we trust our own image URLs

  document.getElementById('modal-cat').textContent =
    (a.is_breaking ? '⚡ Breaking — ' : '') + (a.category || '');
  document.getElementById('modal-title').textContent = a.title || '';
  document.getElementById('modal-desc').textContent = a.description || a.excerpt || '';

  buildByline(a);

  // body is server-side sanitised HTML (only <p>,<em>,<strong>,<a href>) — safe to inject
  document.getElementById('modal-content').innerHTML =
    a.body || '<p>' + escAttr(a.excerpt || '') + '</p>';

  buildTags(a.tags);

  document.getElementById('modal-backdrop').classList.add('open');
  document.body.style.overflow = 'hidden';
  history.replaceState(null, '', '#' + slug);
}

function closeModal(e) {
  if (e.target === document.getElementById('modal-backdrop')) closeModalBtn();
}

function closeModalBtn() {
  document.getElementById('modal-backdrop').classList.remove('open');
  document.body.style.overflow = '';
  history.replaceState(null, '', window.location.pathname);
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeModalBtn();
});

// Open from URL hash on load
if (location.hash) {
  const slug = location.hash.slice(1);
  if (articleMap[slug]) openArticle(slug);
}

// ── Category filter ──────────────────────────────────────────────
function filterCategory(cat, btn) {
  // Update nav button state
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');

  const allSection   = document.getElementById('all-articles-section');
  const latestSection = document.getElementById('section-latest');
  const heroSection  = document.getElementById('section-hero');
  const catSections  = document.querySelectorAll('[data-category-section]');

  if (cat === 'all') {
    allSection.style.display = 'none';
    if (latestSection) latestSection.style.display = '';
    if (heroSection)   heroSection.style.display = '';
    catSections.forEach(s => s.style.display = '');
    document.querySelector('.nav-btn').classList.add('active');
    return;
  }

  // Show filtered view
  if (latestSection) latestSection.style.display = 'none';
  if (heroSection)   heroSection.style.display = 'none';
  catSections.forEach(s => s.style.display = 'none');
  allSection.style.display = '';

  const label = document.getElementById('filter-label');
  if (label) label.textContent = cat;

  const grid = document.getElementById('filtered-grid');
  const filtered = ARTICLES.filter(a => a.category === cat);
  if (filtered.length === 0) {
    grid.innerHTML = '<p style="color:var(--muted);font-family:var(--font-ui);font-size:.85rem;grid-column:1/-1;padding:40px 0;text-align:center;">No articles in this category yet.</p>';
    return;
  }
  // Build cards with DOM APIs to avoid XSS from untrusted article fields
  grid.innerHTML = '';
  filtered.forEach(a => {
    const art = document.createElement('article');
    art.className = 'card';
    art.addEventListener('click', () => openArticle(a.slug));

    const imgWrap = document.createElement('div');
    imgWrap.className = 'card-img-wrap';
    const img = document.createElement('img');
    img.src = a.thumb_image || '';
    img.alt = '';
    img.className = 'card-img';
    img.loading = 'lazy';
    const catBadge = document.createElement('span');
    catBadge.className = 'card-category' + (a.is_breaking ? ' breaking' : '');
    catBadge.textContent = (a.is_breaking ? '⚡ ' : '') + (a.category || '');
    imgWrap.appendChild(img);
    imgWrap.appendChild(catBadge);

    const body = document.createElement('div');
    body.className = 'card-body';
    const title = document.createElement('div');
    title.className = 'card-title';
    title.textContent = a.title || '';
    const excerpt = document.createElement('div');
    excerpt.className = 'card-excerpt';
    excerpt.textContent = a.excerpt || '';
    const footer = document.createElement('div');
    footer.className = 'card-footer';
    const dateSpan = document.createElement('span');
    dateSpan.textContent = a.date_display || '';
    const readSpan = document.createElement('span');
    const dot = document.createElement('span');
    dot.className = 'card-dot';
    dot.textContent = '·';
    readSpan.appendChild(dot);
    readSpan.appendChild(document.createTextNode((a.reading_time || 1) + ' min'));
    footer.appendChild(dateSpan);
    footer.appendChild(readSpan);
    body.appendChild(title);
    body.appendChild(excerpt);
    body.appendChild(footer);

    art.appendChild(imgWrap);
    art.appendChild(body);
    grid.appendChild(art);
  });
}
</script>
</body>
</html>
