<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{{ site_title }} — {{ site_tagline }}</title>
<meta name="description" content="{{ site_description }}">
<meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large">
<meta name="author" content="{{ site_title }} Editorial Team">
<meta name="geo.region" content="MA-01">
<meta name="geo.placename" content="Marrakech, Morocco">
<link rel="canonical" href="{{ site_url }}/">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site_title }}">
<meta property="og:title" content="{{ site_title }} — {{ site_tagline }}">
<meta property="og:description" content="{{ site_description }}">
<meta property="og:url" content="{{ site_url }}/">
<meta property="og:image" content="https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=1200&q=80">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_US">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ site_twitter }}">
<meta name="twitter:title" content="{{ site_title }} — {{ site_tagline }}">
<meta name="twitter:description" content="{{ site_description }}">
<meta name="twitter:image" content="https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=1200&q=80">

<!-- RSS & Sitemap -->
<link rel="alternate" type="application/rss+xml" title="{{ site_title }} RSS" href="{{ site_url }}/feed.xml">
<link rel="sitemap" type="application/xml" href="{{ site_url }}/sitemap.xml">

<!-- Schema.org -->
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"NewsMediaOrganization",
  "name":"{{ site_title }}",
  "url":"{{ site_url }}/",
  "description":"{{ site_description }}",
  "foundingDate":"2024",
  "address":{"@type":"PostalAddress","addressLocality":"Marrakech","addressCountry":"MA"}
}
</script>

<meta name="theme-color" content="#C8102E">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📰</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://images.unsplash.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════════════
   MARRAKECH DAILY — NEWSPAPER DESIGN SYSTEM
   Inspired by: NYT, NYPost, USA Today, AP News
═══════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --red:#C8102E;--red-d:#9B0B22;--red-l:#FFF0F2;
  --black:#0A0A0A;--ink:#1A1A1A;--coal:#2D2D2D;
  --muted:#666;--faint:#999;--rule:#E0E0E0;
  --bg:#F8F8F8;--white:#FFF;--sand:#F5F1EB;--sand2:#FAF7F2;
  --gold:#B06B00;--teal:#0A5C45;
  --ff-disp:'Playfair Display',Georgia,serif;
  --ff-body:'Source Serif 4',Georgia,serif;
  --ff-ui:'Inter',system-ui,sans-serif;
  --r:2px;
  --shadow-sm:0 1px 4px rgba(0,0,0,.08);
  --shadow-md:0 4px 16px rgba(0,0,0,.1);
  --shadow-lg:0 8px 32px rgba(0,0,0,.12);
}
html{font-size:16px;scroll-behavior:smooth}
body{font-family:var(--ff-ui);background:var(--bg);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit;transition:color .15s}
img{display:block;width:100%;height:100%;object-fit:cover}
button,input{font-family:var(--ff-ui);border:none;outline:none;cursor:pointer;background:none}

/* ── UTILITIES ── */
.container{max-width:1380px;margin:0 auto;padding:0 20px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
.skip-link{position:absolute;top:-50px;left:8px;background:var(--red);color:#fff;padding:10px 18px;z-index:10000;font-weight:700;font-size:13px;border-radius:var(--r);transition:top .2s}
.skip-link:focus{top:8px}
.tag{display:inline-block;font-family:var(--ff-ui);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:3px 8px;border:1px solid var(--rule);color:var(--muted);cursor:pointer;transition:all .15s}
.tag:hover{border-color:var(--red);color:var(--red)}
.cat-badge{display:inline-block;font-family:var(--ff-ui);font-size:9px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:3px 10px;background:var(--red);color:#fff}
.cat-badge.breaking{background:var(--black);animation:pulse-b 1.8s ease-in-out infinite}
@keyframes pulse-b{0%,100%{opacity:1}50%{opacity:.6}}
.byline{font-family:var(--ff-ui);font-size:11px;color:var(--muted);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.byline .sep{color:var(--rule)}
.byline .author{font-weight:600;color:var(--coal)}
.timestamp{font-family:var(--ff-ui);font-size:10px;color:var(--faint)}
.read-more{display:inline-flex;align-items:center;gap:5px;font-family:var(--ff-ui);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--red);cursor:pointer;border-bottom:2px solid transparent;transition:border-color .2s;background:none;padding:0}
.read-more:hover{border-bottom-color:var(--red)}

/* ── BREAKING TICKER ── */
.ticker-outer{background:var(--red);overflow:hidden;height:32px;display:flex;align-items:center}
.ticker-label{background:var(--black);color:#fff;font-family:var(--ff-ui);font-size:9px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;padding:0 16px;height:100%;display:flex;align-items:center;white-space:nowrap;flex-shrink:0}
.ticker-track{flex:1;overflow:hidden;height:100%;display:flex;align-items:center}
.ticker-scroll{display:inline-flex;gap:0;animation:ticker-move 60s linear infinite;white-space:nowrap;color:#fff;font-family:var(--ff-ui);font-size:11px;font-weight:600;letter-spacing:.02em}
.ticker-scroll:hover{animation-play-state:paused}
.ticker-item{padding:0 28px}
.ticker-dot{color:rgba(255,255,255,.45);margin:0 4px}
@keyframes ticker-move{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* ── HEADER ── */
.site-header{background:var(--white);border-bottom:3px solid var(--red);position:sticky;top:0;z-index:900;box-shadow:var(--shadow-sm);transition:box-shadow .2s}
.site-header.scrolled{box-shadow:var(--shadow-md)}
.header-top{display:flex;align-items:center;justify-content:space-between;padding:10px 20px;border-bottom:1px solid var(--rule);max-width:1380px;margin:0 auto}
.header-left{font-family:var(--ff-ui);font-size:11px;color:var(--muted);letter-spacing:.04em;line-height:1.4}
.header-left strong{color:var(--coal)}
.site-logo{text-align:center;cursor:pointer}
.logo-pre{font-family:var(--ff-ui);font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:1px}
.logo-name{font-family:var(--ff-disp);font-size:38px;font-weight:900;color:var(--black);letter-spacing:-.025em;line-height:1}
.logo-name em{color:var(--red);font-style:normal}
.logo-sub{font-family:var(--ff-ui);font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-top:1px}
.header-right{display:flex;align-items:center;gap:10px}
.btn-subscribe{background:var(--red);color:#fff;padding:7px 16px;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border-radius:var(--r);transition:background .2s}
.btn-subscribe:hover{background:var(--red-d)}
.btn-icon{width:34px;height:34px;border:1.5px solid var(--rule);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--coal);transition:all .2s}
.btn-icon:hover{border-color:var(--red);color:var(--red)}
.rss-btn{display:flex;align-items:center;gap:4px;font-family:var(--ff-ui);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#F26522;border:1px solid #F26522;padding:4px 8px;border-radius:var(--r);transition:all .2s}
.rss-btn:hover{background:#F26522;color:#fff}

/* ── NAVIGATION ── */
.site-nav{border-bottom:2px solid var(--black)}
.nav-inner{max-width:1380px;margin:0 auto;padding:0 20px;display:flex;align-items:center;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.nav-inner::-webkit-scrollbar{display:none}
.nav-link{font-family:var(--ff-ui);font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--coal);padding:11px 14px;border-bottom:3px solid transparent;margin-bottom:-2px;white-space:nowrap;cursor:pointer;transition:all .15s}
.nav-link:hover,.nav-link.active{color:var(--red);border-bottom-color:var(--red)}
.nav-link.breaking{color:var(--red)}
.nav-sep{width:1px;height:16px;background:var(--rule);flex-shrink:0;margin:0 4px}

/* ── SEARCH DROPDOWN ── */
.search-bar{display:none;background:var(--sand);border-bottom:1px solid var(--rule);padding:10px 20px}
.search-bar.open{display:block}
.search-wrap{max-width:600px;margin:0 auto;display:flex;gap:8px}
.search-input{flex:1;padding:10px 14px;border:1.5px solid var(--rule);font-size:14px;border-radius:var(--r);background:var(--white);transition:border-color .2s}
.search-input:focus{border-color:var(--red)}
.search-btn-x{padding:10px 14px;background:var(--red);color:#fff;border-radius:var(--r);font-weight:700;font-size:12px}
.search-results{max-width:600px;margin:8px auto 0;font-size:13px}
.search-result-item{padding:9px 0;border-bottom:1px solid var(--rule);cursor:pointer;transition:padding-left .15s}
.search-result-item:hover{padding-left:6px}
.sri-cat{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--red)}
.sri-title{font-weight:600;color:var(--black);margin-top:2px;font-size:14px}

/* ── WEATHER BAR ── */
.weather-bar{background:var(--sand2);border-bottom:1px solid var(--rule);padding:6px 0;overflow-x:auto}
.weather-inner{max-width:1380px;margin:0 auto;padding:0 20px;display:flex;align-items:center;gap:20px;white-space:nowrap;font-family:var(--ff-ui);font-size:11px;color:var(--muted)}
.weather-inner strong{color:var(--coal)}
.weather-sep{color:var(--rule)}

/* ── SECTION HEADERS ── */
.section-hd{border-top:3px solid var(--black);padding-top:14px;margin-bottom:20px;display:flex;align-items:center;gap:12px}
.section-hd.red{border-color:var(--red)}
.section-hd.teal{border-color:var(--teal)}
.section-hd.gold{border-color:var(--gold)}
.section-name{font-family:var(--ff-disp);font-size:20px;font-weight:900;color:var(--black)}
.section-name .lbl{font-family:var(--ff-ui);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:var(--red);padding:3px 10px;margin-right:8px}
.section-name .lbl.teal{background:var(--teal)}
.section-name .lbl.gold{background:var(--gold)}
.section-name .lbl.black{background:var(--black)}
.section-see-all{margin-left:auto;font-family:var(--ff-ui);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--red);border-bottom:1.5px solid var(--red);cursor:pointer}

/* ── MODAL ── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.78);z-index:9999;overflow-y:auto;padding:16px}
.modal-overlay.open{display:flex;align-items:flex-start;justify-content:center}
.modal-box{background:var(--white);max-width:800px;width:100%;margin:0 auto;border-radius:var(--r);box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
.modal-close{position:absolute;top:14px;right:14px;width:36px;height:36px;background:var(--black);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;z-index:2;cursor:pointer;transition:background .2s}
.modal-close:hover{background:var(--red)}
.modal-img{height:320px;overflow:hidden;background:var(--sand)}
.modal-img img{transition:transform .5s}
.modal-body{padding:28px 32px 36px}
.modal-cat-badge{margin-bottom:12px}
.modal-title{font-family:var(--ff-disp);font-size:26px;font-weight:900;line-height:1.18;color:var(--black);margin-bottom:12px;letter-spacing:-.02em}
.modal-meta{display:flex;align-items:center;gap:10px;font-family:var(--ff-ui);font-size:11px;color:var(--muted);margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--rule);flex-wrap:wrap}
.modal-meta .author{font-weight:600;color:var(--coal)}
.modal-content{font-family:var(--ff-body);font-size:16px;line-height:1.78;color:var(--coal)}
.modal-content p{margin-bottom:15px}
.modal-content h2{font-family:var(--ff-disp);font-size:21px;font-weight:700;margin:24px 0 10px;color:var(--black)}
.modal-content h3{font-family:var(--ff-disp);font-size:17px;font-weight:700;margin:18px 0 8px;color:var(--black)}
.modal-content strong{font-weight:700;color:var(--black)}
.modal-src{margin-top:20px;padding:10px 14px;background:var(--sand);border-left:3px solid var(--red);font-family:var(--ff-ui);font-size:11px;color:var(--muted);border-radius:0 var(--r) var(--r) 0}
.modal-src a{color:var(--red)}
.modal-tags{margin-top:14px;display:flex;flex-wrap:wrap;gap:5px}
@media(max-width:640px){.modal-body{padding:18px 16px 24px}.modal-title{font-size:20px}.modal-img{height:200px}}

/* ═══════════════════════════════════════════════════
   HOMEPAGE LAYOUT
═══════════════════════════════════════════════════ */
section{padding:36px 0}
section+section{border-top:1px solid var(--rule)}

/* ── HERO SECTION ── */
.hero-section{padding:28px 0 0;background:var(--white)}
.hero-grid{display:grid;grid-template-columns:1fr 320px;gap:0;border:1px solid var(--rule);background:var(--white)}

/* Hero main */
.hero-main{overflow:hidden;cursor:pointer}
.hero-img-wrap{height:430px;overflow:hidden;position:relative;background:var(--sand)}
.hero-img-wrap img{transition:transform .5s ease}
.hero-main:hover .hero-img-wrap img{transform:scale(1.02)}
.hero-overlay-cat{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(0,0,0,.72) 0%,transparent 100%);padding:40px 20px 16px}
.hero-content{padding:22px 24px 24px;border-top:3px solid var(--red)}
.hero-title{font-family:var(--ff-disp);font-size:28px;font-weight:900;line-height:1.14;color:var(--black);margin-bottom:12px;letter-spacing:-.022em;cursor:pointer;transition:color .15s}
.hero-title:hover{color:var(--red)}
.hero-excerpt{font-family:var(--ff-body);font-size:15px;color:var(--coal);line-height:1.62;margin-bottom:14px}

/* Hero sidebar */
.hero-sidebar{border-left:1px solid var(--rule);display:flex;flex-direction:column;background:var(--white)}
.sidebar-label{background:var(--black);color:#fff;font-family:var(--ff-ui);font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase;padding:9px 16px}
.sidebar-article{display:grid;grid-template-columns:1fr 76px;gap:10px;padding:13px 14px;border-bottom:1px solid var(--rule);cursor:pointer;transition:background .15s;align-items:start}
.sidebar-article:hover{background:var(--sand2)}
.sidebar-article:last-child{border-bottom:none;flex:1}
.sa-num{font-family:var(--ff-disp);font-size:28px;font-weight:900;color:var(--rule);line-height:1;margin-bottom:3px}
.sa-cat{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--red);margin-bottom:4px;font-family:var(--ff-ui)}
.sa-title{font-family:var(--ff-disp);font-size:13px;font-weight:700;line-height:1.32;color:var(--black)}
.sidebar-article:hover .sa-title{color:var(--red)}
.sa-meta{font-size:9px;color:var(--faint);font-family:var(--ff-ui);margin-top:4px}
.sa-thumb{height:64px;overflow:hidden;border-radius:var(--r);background:var(--sand)}

/* ── AD SLOT ── */
.ad-slot{background:var(--sand);border:1px dashed var(--rule);display:flex;align-items:center;justify-content:center;font-family:var(--ff-ui);font-size:10px;color:var(--faint);letter-spacing:.06em;text-transform:uppercase}
.ad-banner{height:90px;margin:24px 0}
.ad-sidebar{height:250px;margin-bottom:20px}

/* ── LATEST NEWS GRID ── */
.latest-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--rule);border-right:none}
.news-card{border-right:1px solid var(--rule);overflow:hidden;cursor:pointer;transition:background .15s}
.news-card:hover{background:var(--sand2)}
.nc-img{height:152px;overflow:hidden;background:var(--sand);flex-shrink:0}
.nc-img img{transition:transform .4s ease}
.news-card:hover .nc-img img{transform:scale(1.05)}
.nc-body{padding:14px}
.nc-cat{font-family:var(--ff-ui);font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--red);margin-bottom:6px}
.nc-title{font-family:var(--ff-disp);font-size:15px;font-weight:700;line-height:1.3;color:var(--black);margin-bottom:7px}
.news-card:hover .nc-title{color:var(--red)}
.nc-excerpt{font-family:var(--ff-body);font-size:13px;color:var(--muted);line-height:1.5;margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}

/* ── FEATURED 3-COLUMN ── */
.featured-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:24px}
.featured-main .fi-img{height:250px;overflow:hidden;background:var(--sand);cursor:pointer}
.featured-main .fi-img img{transition:transform .4s}
.featured-main:hover .fi-img img{transform:scale(1.03)}
.fi-body{padding:14px 0}
.fi-cat{font-family:var(--ff-ui);font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--teal);margin-bottom:6px}
.fi-title{font-family:var(--ff-disp);font-size:19px;font-weight:700;line-height:1.24;color:var(--black);margin-bottom:8px;cursor:pointer;transition:color .15s}
.fi-title:hover{color:var(--red)}
.fi-title.sm{font-size:15px}
.fi-excerpt{font-family:var(--ff-body);font-size:13px;color:var(--muted);line-height:1.55;margin-bottom:8px}
.fi-side-card{border-top:3px solid var(--rule);padding-top:13px;margin-bottom:16px;cursor:pointer}
.fi-side-card:hover .fi-title{color:var(--red)}
.fi-side-card:last-child{margin-bottom:0}
.fi-side-img{height:110px;overflow:hidden;margin-bottom:9px;background:var(--sand);border-radius:var(--r)}
.fi-side-img img{transition:transform .4s}
.fi-side-card:hover .fi-side-img img{transform:scale(1.04)}

/* ── DARK SECTION (Tourism) ── */
.dark-section{background:linear-gradient(150deg,#0B1A13 0%,#15312A 100%);padding:36px 0}
.dark-section .section-hd{border-color:var(--teal)}
.dark-section .section-name{color:#fff}
.dark-section .section-see-all{color:#4ECBA8;border-color:#4ECBA8}
.dark-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:20px}
.dark-card{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);overflow:hidden;cursor:pointer;transition:background .2s,transform .2s;border-radius:var(--r)}
.dark-card:hover{background:rgba(255,255,255,.13);transform:translateY(-3px)}
.dc-img{height:172px;overflow:hidden;background:rgba(255,255,255,.05)}
.dc-img img{transition:transform .4s}
.dark-card:hover .dc-img img{transform:scale(1.05)}
.dc-body{padding:14px}
.dc-label{font-family:var(--ff-ui);font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#4ECBA8;margin-bottom:5px}
.dc-title{font-family:var(--ff-disp);font-size:15px;font-weight:700;color:#fff;line-height:1.3;margin-bottom:6px}
.dark-card:hover .dc-title{color:#4ECBA8}
.dc-meta{font-family:var(--ff-ui);font-size:10px;color:rgba(255,255,255,.45)}
.dark-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-top:20px;border:1px solid rgba(255,255,255,.08)}
.ds-box{background:rgba(255,255,255,.06);padding:14px;text-align:center}
.ds-num{font-family:var(--ff-disp);font-size:24px;font-weight:900;color:#fff}
.ds-lbl{font-family:var(--ff-ui);font-size:9px;color:rgba(255,255,255,.45);letter-spacing:.1em;text-transform:uppercase;margin-top:2px}

/* ── 4-GRID (Real Estate etc) ── */
.quad-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--rule)}
.quad-card{display:grid;grid-template-columns:140px 1fr;gap:0;border-bottom:1px solid var(--rule);overflow:hidden;cursor:pointer;transition:background .15s}
.quad-card:hover{background:var(--sand2)}
.quad-card:nth-child(odd){border-right:1px solid var(--rule)}
.qc-img{height:120px;overflow:hidden;background:var(--sand)}
.qc-img img{transition:transform .3s}
.quad-card:hover .qc-img img{transform:scale(1.04)}
.qc-body{padding:12px 14px}
.qc-badge{display:inline-block;font-family:var(--ff-ui);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;background:var(--sand);color:var(--gold);padding:2px 7px;margin-bottom:5px;border-radius:var(--r)}
.qc-title{font-family:var(--ff-disp);font-size:14px;font-weight:700;line-height:1.3;color:var(--black);margin-bottom:5px}
.quad-card:hover .qc-title{color:var(--red)}
.qc-meta{font-family:var(--ff-ui);font-size:10px;color:var(--muted);margin-top:6px;display:flex;gap:8px;flex-wrap:wrap}

/* ── EVENTS CALENDAR ── */
.events-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--rule)}
.event-card{display:flex;align-items:stretch;border-bottom:1px solid var(--rule);overflow:hidden;cursor:pointer;transition:background .15s}
.event-card:hover{background:var(--sand2)}
.event-card:nth-child(odd){border-right:1px solid var(--rule)}
.ev-date{background:var(--black);color:#fff;min-width:58px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px 6px;flex-shrink:0}
.ev-month{font-family:var(--ff-ui);font-size:8px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--red)}
.ev-day{font-family:var(--ff-disp);font-size:26px;font-weight:900;line-height:1;color:#fff}
.ev-body{padding:11px 13px}
.ev-cat{font-size:8px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--red);font-family:var(--ff-ui);margin-bottom:3px}
.ev-title{font-family:var(--ff-disp);font-size:13px;font-weight:700;line-height:1.3;color:var(--black);margin-bottom:4px}
.event-card:hover .ev-title{color:var(--red)}
.ev-meta{font-family:var(--ff-ui);font-size:10px;color:var(--muted)}

/* ── LIFESTYLE VISUAL GRID ── */
.lifestyle-grid{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--rule);border-right:none}
.ls-card{border-right:1px solid var(--rule);overflow:hidden;position:relative;height:265px;cursor:pointer}
.ls-card img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
.ls-card:hover img{transform:scale(1.07)}
.ls-overlay{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(0,0,0,.82) 0%,transparent 100%);padding:20px 14px 14px;color:#fff}
.ls-label{font-family:var(--ff-ui);font-size:8px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin-bottom:4px}
.ls-title{font-family:var(--ff-disp);font-size:13px;font-weight:700;line-height:1.3;color:#fff}
.ls-card:hover .ls-title{color:#f88}

/* ── MOST READ ── */
.most-read-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:0;border:1px solid var(--rule)}
.mr-card{padding:16px;border-right:1px solid var(--rule);cursor:pointer;transition:background .15s}
.mr-card:last-child{border-right:none}
.mr-card:hover{background:var(--sand2)}
.mr-rank{font-family:var(--ff-disp);font-size:46px;font-weight:900;color:var(--red-l);line-height:1;margin-bottom:6px}
.mr-cat{font-size:8px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--red);font-family:var(--ff-ui);margin-bottom:5px}
.mr-title{font-family:var(--ff-disp);font-size:13px;font-weight:700;line-height:1.35;color:var(--black);margin-bottom:6px}
.mr-card:hover .mr-title{color:var(--red)}
.mr-views{font-family:var(--ff-ui);font-size:10px;color:var(--faint)}

/* ── NEWSLETTER ── */
.newsletter{background:var(--black);padding:56px 0}
.nl-inner{max-width:640px;margin:0 auto;text-align:center;padding:0 20px}
.nl-eyebrow{font-family:var(--ff-ui);font-size:9px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--red);margin-bottom:10px}
.nl-title{font-family:var(--ff-disp);font-size:32px;font-weight:900;color:#fff;line-height:1.14;margin-bottom:10px}
.nl-sub{font-family:var(--ff-body);font-size:15px;color:rgba(255,255,255,.6);line-height:1.62;margin-bottom:24px}
.nl-form{display:flex;max-width:480px;margin:0 auto 12px;gap:0}
.nl-input{flex:1;padding:13px 16px;font-size:14px;border:none;background:#fff;color:var(--black);border-radius:var(--r) 0 0 var(--r)}
.nl-input:focus{outline:2px solid var(--red);outline-offset:-2px}
.nl-btn{background:var(--red);color:#fff;padding:13px 20px;font-family:var(--ff-ui);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border-radius:0 var(--r) var(--r) 0;transition:background .2s;white-space:nowrap;border:none;cursor:pointer}
.nl-btn:hover{background:var(--red-d)}
.nl-note{font-family:var(--ff-ui);font-size:10px;color:rgba(255,255,255,.3);margin-top:8px}
.nl-stats{display:flex;align-items:center;justify-content:center;gap:28px;margin-top:24px;flex-wrap:wrap}
.nls-num{font-family:var(--ff-disp);font-size:22px;font-weight:900;color:#fff}
.nls-lbl{font-family:var(--ff-ui);font-size:9px;color:rgba(255,255,255,.38);letter-spacing:.1em;text-transform:uppercase}

/* ── FOOTER ── */
.site-footer{background:var(--ink);color:rgba(255,255,255,.65);padding:44px 0 20px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:36px;margin-bottom:36px}
.footer-logo .logo-name{font-size:26px;color:#fff}
.footer-logo .logo-name em{color:var(--red)}
.footer-desc{font-family:var(--ff-body);font-size:13px;color:rgba(255,255,255,.45);line-height:1.6;margin:10px 0 16px}
.footer-social{display:flex;gap:7px}
.social-btn{width:32px;height:32px;border:1px solid rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:12px;color:rgba(255,255,255,.55);cursor:pointer;transition:all .2s;border-radius:var(--r);background:none}
.social-btn:hover{border-color:var(--red);color:var(--red)}
.footer-col-title{font-family:var(--ff-ui);font-size:9px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:#fff;margin-bottom:12px;padding-bottom:7px;border-bottom:1px solid rgba(255,255,255,.08)}
.footer-links{list-style:none}
.footer-links li{margin-bottom:8px}
.footer-links a,.footer-links span{font-family:var(--ff-ui);font-size:12px;color:rgba(255,255,255,.5);cursor:pointer;transition:color .15s}
.footer-links a:hover,.footer-links span:hover{color:#fff}
.footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:16px;display:flex;align-items:center;justify-content:space-between;font-family:var(--ff-ui);font-size:10px;color:rgba(255,255,255,.28);flex-wrap:wrap;gap:8px}
.footer-bottom-links{display:flex;gap:16px}
.footer-bottom-links a{color:rgba(255,255,255,.28)}
.footer-bottom-links a:hover{color:rgba(255,255,255,.6)}

/* ── BREADCRUMB ── */
.breadcrumb-bar{background:var(--white);border-bottom:1px solid var(--rule)}
.breadcrumb{font-family:var(--ff-ui);font-size:10px;color:var(--muted);padding:6px 0;display:flex;align-items:center;gap:5px;list-style:none}
.breadcrumb a{color:var(--red)}
.breadcrumb .sep{color:var(--rule)}

/* ═══════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════ */
@media(max-width:1100px){
  .hero-grid{grid-template-columns:1fr}
  .hero-sidebar{border-left:none;border-top:1px solid var(--rule);display:grid;grid-template-columns:1fr 1fr}
  .sidebar-label{grid-column:1/-1}
  .latest-grid{grid-template-columns:1fr 1fr}
  .featured-grid{grid-template-columns:1fr 1fr}
  .most-read-grid{grid-template-columns:repeat(3,1fr)}
  .footer-grid{grid-template-columns:1fr 1fr}
  .dark-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:768px){
  .logo-name{font-size:26px}
  .header-left{display:none}
  .hero-title{font-size:20px}
  .hero-img-wrap{height:220px}
  .hero-sidebar{grid-template-columns:1fr}
  .latest-grid,.featured-grid,.dark-grid,.quad-grid,.events-grid,.lifestyle-grid{grid-template-columns:1fr}
  .most-read-grid{grid-template-columns:1fr 1fr}
  .footer-grid{grid-template-columns:1fr}
  .footer-bottom{flex-direction:column;text-align:center}
  .nl-form{flex-direction:column;border-radius:var(--r)}
  .nl-input{border-radius:var(--r) var(--r) 0 0}
  .nl-btn{border-radius:0 0 var(--r) var(--r)}
  .dark-stats{grid-template-columns:1fr 1fr}
  .quad-card{grid-template-columns:1fr}
  .qc-img{height:160px}
  .nav-link{padding:10px 10px;font-size:10px}
  .container{padding:0 14px}
  section{padding:24px 0}
}
@media(max-width:480px){
  .logo-name{font-size:22px}
  .hero-img-wrap{height:180px}
  .most-read-grid{grid-template-columns:1fr}
  .header-right .rss-btn{display:none}
}
</style>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>

<!-- ═══════════════════════════════════════════
     ARTICLE MODAL
═══════════════════════════════════════════ -->
<div class="modal-overlay" id="articleModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-box">
    <button class="modal-close" id="modalClose" aria-label="Close article">✕</button>
    <div class="modal-img"><img id="modalImg" src="" alt="" loading="lazy"></div>
    <div class="modal-body">
      <div class="modal-cat-badge" id="modalCat"></div>
      <h2 class="modal-title" id="modalTitle"></h2>
      <div class="modal-meta" id="modalMeta"></div>
      <div class="modal-content" id="modalContent"></div>
      <div class="modal-src" id="modalSrc" style="display:none"></div>
      <div class="modal-tags" id="modalTags"></div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     BREAKING NEWS TICKER
═══════════════════════════════════════════ -->
<div class="ticker-outer" role="marquee" aria-label="Breaking news">
  <div class="ticker-label">⚡ Breaking</div>
  <div class="ticker-track">
    <div class="ticker-scroll" id="tickerScroll">
      {% for item in ticker_items %}<span class="ticker-item">{{ item }}<span class="ticker-dot"> ◆ </span></span>{% endfor %}
      {% for item in ticker_items %}<span class="ticker-item">{{ item }}<span class="ticker-dot"> ◆ </span></span>{% endfor %}
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     STICKY HEADER
═══════════════════════════════════════════ -->
<header class="site-header" id="siteHeader" role="banner">
  <div class="header-top">
    <div class="header-left">
      <strong>{{ today_display }}</strong><br>
      Marrakech, Morocco &nbsp;·&nbsp; ☀ {{ weather_temp }}
    </div>
    <div class="site-logo" onclick="window.scrollTo(0,0)">
      <div class="logo-pre">Est. 2024</div>
      <div class="logo-name">MARRAKECH <em>DAILY</em></div>
      <div class="logo-sub">Your English-Language Window to the Red City</div>
    </div>
    <div class="header-right">
      <a href="feed.xml" class="rss-btn" title="RSS Feed" aria-label="RSS Feed">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
        RSS
      </a>
      <button class="btn-icon" id="searchToggle" aria-label="Search" aria-expanded="false">🔍</button>
      <button class="btn-subscribe" onclick="document.getElementById('newsletter').scrollIntoView({behavior:'smooth'})">Subscribe</button>
    </div>
  </div>

  <!-- Navigation -->
  <nav role="navigation" aria-label="Main navigation">
    <div class="nav-inner">
      <span class="nav-link breaking active" data-cat="all" tabindex="0">All News</span>
      <div class="nav-sep"></div>
      {% for cat in categories %}
      <span class="nav-link" data-cat="{{ cat }}" tabindex="0">{% if cat == 'Breaking' %}⚡ {% endif %}{{ cat }}</span>
      {% endfor %}
    </div>
  </nav>

  <!-- Search bar -->
  <div class="search-bar" id="searchBar" role="search">
    <div class="search-wrap">
      <input type="search" class="search-input" id="searchInput"
        placeholder="Search Marrakech Daily…" autocomplete="off" aria-label="Search articles">
      <button class="search-btn-x" onclick="closeSearch()" aria-label="Close search">✕</button>
    </div>
    <div class="search-results" id="searchResults" role="listbox"></div>
  </div>
</header>

<!-- Weather Bar -->
<div class="weather-bar" aria-label="Weather and market data">
  <div class="weather-inner">
    <span>📍 <strong>Marrakech</strong> {{ weather_icon }} {{ weather_temp }} · {{ weather_desc }}</span>
    <span class="weather-sep">|</span>
    <span>🏔 <strong>Atlas</strong> 24°C</span>
    <span class="weather-sep">|</span>
    <span>🌊 <strong>Essaouira</strong> 22°C</span>
    <span class="weather-sep">|</span>
    <span>💶 <strong>EUR/MAD</strong> 10.74 · <strong>USD/MAD</strong> 9.87 · <strong>GBP/MAD</strong> 12.51</span>
    <span class="weather-sep">|</span>
    <span>✈ <strong>Menara Airport</strong> Operating normally</span>
  </div>
</div>

<!-- Breadcrumb -->
<div class="breadcrumb-bar">
  <div class="container">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li><a href="{{ site_url }}/">Home</a></li>
        <li class="sep">›</li>
        <li aria-current="page">Latest News</li>
      </ol>
    </nav>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     MAIN CONTENT
═══════════════════════════════════════════ -->
<main id="main-content" role="main">

{% if hero %}
<!-- ── HERO SECTION ── -->
<div class="hero-section">
  <div class="container">
    <hr style="border:none;border-top:3px solid var(--black);margin-bottom:18px">
    <div class="hero-grid">

      <!-- Hero Main Article -->
      <article class="hero-main" onclick="openArticle('{{ hero.slug }}')"
        aria-label="{{ hero.title }}">
        <div class="hero-img-wrap">
          <img src="{{ hero.image_url }}" alt="{{ hero.title }}" loading="eager">
          <div class="hero-overlay-cat">
            <span class="cat-badge {% if hero.is_breaking %}breaking{% endif %}">
              {% if hero.is_breaking %}⚡ BREAKING · {% endif %}{{ hero.category }}
            </span>
          </div>
        </div>
        <div class="hero-content">
          <div style="margin-bottom:8px;display:flex;gap:6px;flex-wrap:wrap">
            {% for tag in hero.tags[:3] %}<span class="tag">{{ tag }}</span>{% endfor %}
          </div>
          <h1 class="hero-title" onclick="openArticle('{{ hero.slug }}')">{{ hero.title }}</h1>
          <p class="hero-excerpt">{{ hero.excerpt }}</p>
          <div class="byline">
            <span class="author">{{ hero.author.name }}</span>
            <span class="sep">|</span>
            <span>{{ hero.author.role }}</span>
            <span class="sep">|</span>
            <span class="timestamp">{{ hero.date_display }}</span>
            <span class="sep">|</span>
            <span>{{ hero.reading_time }} min read</span>
          </div>
          <button class="read-more" style="margin-top:14px" onclick="openArticle('{{ hero.slug }}')">
            Read Full Story →
          </button>
        </div>
      </article>

      <!-- Sidebar Top Stories -->
      <aside class="hero-sidebar">
        <div class="sidebar-label">Today's Top Stories</div>
        {% for art in sidebar_articles %}
        <div class="sidebar-article" onclick="openArticle('{{ art.slug }}')"
          tabindex="0" role="button" aria-label="{{ art.title }}">
          <div>
            <div class="sa-num">{{ loop.index + 1 }}</div>
            <div class="sa-cat">{{ art.category }}</div>
            <div class="sa-title">{{ art.title }}</div>
            <div class="sa-meta">{{ art.date_display }} · {{ art.reading_time }} min</div>
          </div>
          <div class="sa-thumb">
            <img src="{{ art.image_url }}" alt="{{ art.title }}" loading="lazy">
          </div>
        </div>
        {% endfor %}
      </aside>

    </div>
  </div>
</div>
{% endif %}

<!-- Ad Banner -->
<div class="container">
  <div class="ad-slot ad-banner">Advertisement — 728×90</div>
</div>

<!-- ── LATEST NEWS ── -->
{% if latest_articles %}
<section>
  <div class="container">
    <div class="section-hd red">
      <div class="section-name"><span class="lbl">Latest</span>Latest from Marrakech</div>
      <span class="section-see-all">See All →</span>
    </div>
    <div class="latest-grid" id="latestGrid">
      {% for art in latest_articles[:8] %}
      <article class="news-card" onclick="openArticle('{{ art.slug }}')"
        tabindex="0" role="button" aria-label="{{ art.title }}">
        <div class="nc-img">
          <img src="{{ art.image_url }}" alt="{{ art.title }}" loading="lazy">
        </div>
        <div class="nc-body">
          <div class="nc-cat">{% if art.is_breaking %}⚡ {% endif %}{{ art.category }}</div>
          <h3 class="nc-title">{{ art.title }}</h3>
          <p class="nc-excerpt">{{ art.excerpt }}</p>
          <div class="byline">
            <span class="timestamp">{{ art.date_display }} · {{ art.reading_time }} min</span>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ── BUSINESS / ECONOMY ── -->
{% if business_articles %}
<section>
  <div class="container">
    <div class="section-hd">
      <div class="section-name"><span class="lbl" style="background:var(--teal)">Business</span>Business & Economy</div>
      <span class="section-see-all">See All →</span>
    </div>
    <div class="featured-grid">
      {% set biz_main = business_articles[0] %}
      <article class="featured-main">
        <div class="fi-img" onclick="openArticle('{{ biz_main.slug }}')">
          <img src="{{ biz_main.image_url }}" alt="{{ biz_main.title }}" loading="lazy">
        </div>
        <div class="fi-body">
          <div class="fi-cat">{{ biz_main.category }}</div>
          <h2 class="fi-title" onclick="openArticle('{{ biz_main.slug }}')">{{ biz_main.title }}</h2>
          <p class="fi-excerpt">{{ biz_main.excerpt }}</p>
          <div class="byline">
            <span class="author">{{ biz_main.author.name }}</span>
            <span class="sep">·</span>
            <span class="timestamp">{{ biz_main.date_display }} · {{ biz_main.reading_time }} min</span>
          </div>
          <button class="read-more" onclick="openArticle('{{ biz_main.slug }}')">Continue →</button>
        </div>
      </article>
      {% for art in business_articles[1:3] %}
      <div>
        <div class="fi-side-card" onclick="openArticle('{{ art.slug }}')">
          <div class="fi-side-img"><img src="{{ art.image_url }}" alt="{{ art.title }}" loading="lazy"></div>
          <div class="fi-cat">{{ art.category }}</div>
          <div class="fi-title sm">{{ art.title }}</div>
          <div class="byline"><span class="timestamp">{{ art.date_display }} · {{ art.reading_time }} min</span></div>
        </div>
        {% if business_articles[loop.index + 2] %}
        {% set art2 = business_articles[loop.index + 2] %}
        <div class="fi-side-card" onclick="openArticle('{{ art2.slug }}')">
          <div class="fi-side-img"><img src="{{ art2.image_url }}" alt="{{ art2.title }}" loading="lazy"></div>
          <div class="fi-cat">{{ art2.category }}</div>
          <div class="fi-title sm">{{ art2.title }}</div>
          <div class="byline"><span class="timestamp">{{ art2.date_display }} · {{ art2.reading_time }} min</span></div>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ── TOURISM (dark bg) ── -->
{% if tourism_articles %}
<div class="dark-section">
  <div class="container">
    <div class="section-hd teal">
      <div class="section-name" style="color:#fff"><span class="lbl teal">Tourism</span>Tourism & Luxury</div>
      <span class="section-see-all">See All →</span>
    </div>
    <div class="dark-grid">
      {% for art in tourism_articles[:3] %}
      <article class="dark-card" onclick="openArticle('{{ art.slug }}')">
        <div class="dc-img"><img src="{{ art.image_url }}" alt="{{ art.title }}" loading="lazy"></div>
        <div class="dc-body">
          <div class="dc-label">{{ art.category }}</div>
          <div class="dc-title">{{ art.title }}</div>
          <div class="dc-meta">{{ art.date_display }} · {{ art.reading_time }} min · {{ art.author.name }}</div>
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="dark-stats">
      <div class="ds-box"><div class="ds-num">4.2M</div><div class="ds-lbl">Visitors 2024</div></div>
      <div class="ds-box"><div class="ds-num">+23%</div><div class="ds-lbl">YoY Growth</div></div>
      <div class="ds-box"><div class="ds-num">12+</div><div class="ds-lbl">New EU Routes</div></div>
      <div class="ds-box"><div class="ds-num">900+</div><div class="ds-lbl">Hotels & Riads</div></div>
    </div>
  </div>
</div>
{% endif %}

<!-- ── NATIONAL / SOCIETY ── -->
{% if national_articles %}
<section>
  <div class="container">
    <div class="section-hd">
      <div class="section-name"><span class="lbl black">National</span>National & Society</div>
      <span class="section-see-all">See All →</span>
    </div>
    <div class="quad-grid">
      {% for art in national_articles[:4] %}
      <div class="quad-card" onclick="openArticle('{{ art.slug }}')">
        <div class="qc-img"><img src="{{ art.image_url }}" alt="{{ art.title }}" loading="lazy"></div>
        <div class="qc-body">
          <span class="qc-badge">{{ art.category }}</span>
